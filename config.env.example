# =====================================================================
#  Konfiguracja "Linux dla Babci"
#  Skopiuj:  cp config.env.example config.env   i dostosuj poniższe.
#  Plik jest wczytywany przez bash – zachowaj składnię (cudzysłowy, nawiasy).
# =====================================================================

# --- Konto Babci -------------------------------------------------------
BABCIA_USER="babcia"                 # login (małe litery, bez polskich znaków)
BABCIA_FULLNAME="Babcia"             # nazwa wyświetlana
BABCIA_GREETING="Dzień dobry, Babciu!"   # nagłówek strony startowej
# Hasło dla NOWEGO konta. Puste = skrypt zapyta interaktywnie.
# (Nie commituj config.env z hasłem – jest w .gitignore.)
BABCIA_PASSWORD=""
AUTOLOGIN="yes"                      # yes = bez ekranu logowania

# --- Wygląd ------------------------------------------------------------
FONT_NAME="Ubuntu"                   # czcionka interfejsu
FONT_SIZE="13"                       # pt (domyślnie w Mincie 10)
DPI="120"                            # 96 = 100%, 120 = 125%, 144 = 150%
GTK_THEME="Mint-Y-Purple"            # jasny motyw z fioletowymi akcentami
ICON_THEME="Mint-Y-Purple"           # fioletowe foldery
CURSOR_THEME="Bibata-Modern-Classic"
CURSOR_SIZE="48"                     # 24 = normalny, 48 = duży
PANEL_SIZE="48"                      # wysokość dolnego paska (px)
DESKTOP_ICON_SIZE="80"               # ikony na pulpicie (px)
DOUBLE_CLICK_TIME="800"              # ms; domyślnie 400 – więcej = łatwiej dwukliknąć
SINGLE_CLICK="no"                    # yes = ikony na pulpicie otwierane jednym kliknięciem
PANEL_COLOR="#4a2c6b"                # kolor dolnego paska; puste = z motywu
ACCENT_COLOR="#7b4fa8"               # kolor akcentów strony startowej
# Tapeta: plik z assets/wallpapers/ albo pełna ścieżka; puste = tapeta Minta
WALLPAPER="lawenda-1-valensole.jpg"
WALLPAPER_CYCLE="daily"              # zmiana tapety (z tego samego folderu): no | hourly | daily | startup

# --- Firefox -----------------------------------------------------------
FIREFOX_SCALE=""                     # np. "1.5"; puste = zgodnie z DPI systemu
FIREFOX_SAVE_PASSWORDS="yes"         # yes = Firefox zapamiętuje hasła
FIREFOX_BLOCK_ADDONS="yes"           # yes = Babcia nie zainstaluje dodatków (poza uBlock)
FIREFOX_BOOKMARKS_TOOLBAR="yes"      # pasek z zakładkami (te same co kafelki)

# Kafelki na stronie startowej i zakładki: "Nazwa|URL|emoji"
TILES=(
  "Wiadomości|https://www.onet.pl|📰"
  "Pogoda|https://pogoda.interia.pl|🌤️"
  "Poczta|https://poczta.wp.pl|✉️"
  "Facebook|https://www.facebook.com|👥"
  "YouTube|https://www.youtube.com|📺"
  "Przepisy|https://www.kwestiasmaku.com|🍲"
)

# --- Ikony na pulpicie: "Nazwa|polecenie|ikona" -----------------------
# %PICTURES% = folder Obrazy Babci, %START_PAGE% = strona startowa z kafelkami.
DESKTOP_ICONS=(
  "Internet|firefox|firefox"
  "Zdjęcia|thunar %PICTURES%|folder-pictures"
  "Wyłącz komputer|xfce4-session-logout --halt|system-shutdown"
)

# --- Pakiety -----------------------------------------------------------
PKGS_ADD=(
  ristretto
  firefox-locale-pl hunspell-pl
  xfce4-pulseaudio-plugin xfce4-whiskermenu-plugin
  fonts-noto-color-emoji
)
PKGS_REMOVE=(
  hexchat transmission-gtk
  aisleriot gnome-mahjongg gnome-mines gnome-sudoku   # bez gier
)

# --- Aktualizacje ------------------------------------------------------
AUTO_UPDATES="yes"                   # automatyczne aktualizacje w tle
HIDE_UPDATE_NOTIFICATIONS="yes"      # Babcia nie widzi ikonki/okienek aktualizacji

# --- Zdalna pomoc ------------------------------------------------------
REMOTE_HELP="rustdesk"               # rustdesk | tailscale | none
RUSTDESK_VERSION="latest"            # albo konkretna wersja, np. "1.4.2"
RUSTDESK_PASSWORD=""                 # stałe hasło dostępu; puste = nie ustawiaj

# --- Wydajność (starszy sprzęt) ---------------------------------------
ZRAM="yes"                           # skompresowany swap w RAM
ZRAM_PERCENT="50"                    # % RAM na zram
DISABLE_BLUETOOTH="yes"
DISABLE_PRINTING="no"                # yes = wyłącza CUPS (gdy brak drukarki)
