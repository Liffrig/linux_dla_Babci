<?xml version="1.0" encoding="UTF-8"?>
<!-- Linux dla Babci: okna – duży tytuł, bez efektów, jeden pulpit -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="${GTK_THEME}"/>
    <property name="title_font" type="string" value="${FONT_NAME} Bold ${FONT_SIZE}"/>
    <property name="button_layout" type="string" value="O|HMC"/>
    <!-- bez kompozytora: szybciej na starym sprzęcie, brak przezroczystości -->
    <property name="use_compositing" type="bool" value="false"/>
    <property name="box_move" type="bool" value="false"/>
    <property name="box_resize" type="bool" value="false"/>
    <!-- jeden pulpit, żeby okna "nie znikały" na innym -->
    <property name="workspace_count" type="int" value="1"/>
    <property name="scroll_workspaces" type="bool" value="false"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
    <property name="wrap_windows" type="bool" value="false"/>
    <!-- bez przyklejania/maksymalizacji po przeciągnięciu do krawędzi -->
    <property name="tile_on_move" type="bool" value="false"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="double_click_action" type="string" value="maximize"/>
    <property name="double_click_time" type="int" value="${DOUBLE_CLICK_TIME}"/>
    <property name="mousewheel_rollup" type="bool" value="false"/>
    <property name="easy_click" type="string" value="Alt"/>
    <property name="placement_ratio" type="int" value="100"/>
    <property name="placement_mode" type="string" value="center"/>
  </property>
</channel>
