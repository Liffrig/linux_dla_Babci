<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Strona startowa</title>
  <style>
    :root {
      --accent: @@ACCENT@@;
      --bg: #f3eef9;
      --card: #ffffff;
      --text: #22182e;
      --muted: #5d4f6e;
      --border: #ddd0ee;
      --focus: #e0a800;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: "Ubuntu", "Noto Sans", sans-serif;
      font-size: 22px;
      min-height: 100vh;
      padding: 20px 40px 40px;
    }
    header {
      display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
      gap: 8px 24px; max-width: 1200px; margin: 0 auto 20px;
    }
    h1 { font-size: 1.9em; margin: 0; }
    .when { text-align: right; }
    #clock { font-size: 2em; font-weight: 700; color: var(--accent); margin: 0; }
    #date { font-size: 1.1em; color: var(--muted); margin: 0; }
    form.search { display: flex; gap: 12px; max-width: 1200px; margin: 0 auto 24px; }
    form.search input {
      flex: 1; font-size: 1.1em; padding: 16px 22px;
      border: 3px solid var(--border); border-radius: 16px; background: #fff; color: var(--text);
    }
    form.search input:focus { outline: none; border-color: var(--accent); }
    form.search button {
      font-size: 1.1em; padding: 0 30px; border: 0; border-radius: 16px;
      background: var(--accent); color: #fff; font-weight: 700; cursor: pointer;
    }
    .tiles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
      max-width: 1200px;
      margin: 0 auto;
    }
    .tile {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 8px; min-height: 150px; padding: 16px;
      background: var(--card); color: var(--text); text-decoration: none;
      border: 3px solid var(--border); border-radius: 24px;
      box-shadow: 0 4px 12px rgba(74,44,107,.10);
      transition: transform .1s, border-color .1s;
    }
    .tile:hover, .tile:focus { border-color: var(--accent); transform: scale(1.03); outline: none; }
    .tile:focus-visible { border-color: var(--focus); }
    .emoji { font-size: 64px; line-height: 1; }
    .name { font-size: 1.3em; font-weight: 700; text-align: center; }
  </style>
</head>
<body>
  <header>
    <h1>@@GREETING@@</h1>
    <div class="when">
      <p id="clock"></p>
      <p id="date"></p>
    </div>
  </header>

  <form class="search" action="https://www.google.com/search" method="get">
    <input name="q" type="search" placeholder="Czego szukasz?" aria-label="Szukaj w internecie" autocomplete="off">
    <button type="submit">Szukaj</button>
  </form>

  <main class="tiles">
@@TILES@@
  </main>

  <script>
    function tick() {
      const now = new Date();
      const date = now.toLocaleDateString('pl-PL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      document.getElementById('date').textContent = date.charAt(0).toUpperCase() + date.slice(1);
      document.getElementById('clock').textContent = now.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
    }
    tick();
    setInterval(tick, 10000);
  </script>
</body>
</html>
